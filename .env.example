# Copy to .env and replace these values. Spring reads this as a properties file; do not quote values.
DB_URL=jdbc:mysql://localhost:3306/chainpoint?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=chainpoint
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=chainpoint
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_VHOST=/
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
PAYMENT_BANK_CODE=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
